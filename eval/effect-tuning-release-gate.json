{
  "version": "1.1-release-gate",
  "created": "2026-03-24",
  "updated": "2026-03-24",
  "description": "效果调优最小发布守门集 —— 固定覆盖 A/B/C/D/E 各 1 个代表 case，并显式覆盖能定位继续查 / 不能定位先补材料 / 用户说法有误先证伪 / 通过实体关联串起证据 四类主链分支。",
  "categories": {
    "A": "服务定位与对象定位",
    "B": "现象真实性与查询正确性",
    "C": "Telemetry-first 排障",
    "D": "实体关联驱动排障",
    "E": "协作式推进"
  },
  "cases": [
    {
      "id": "ET-A1",
      "category": "A",
      "subcategory": "A1",
      "title": "无显式服务标识 — 应补材料",
      "prompt": "查下我的服务情况",
      "context": {
        "user_id": "sre-gaming"
      },
      "expect": {
        "action": "request_evidence",
        "must_contain": [
          "服务名",
          "Pod",
          "域名"
        ],
        "must_not_contain": [],
        "max_reply_length": 500,
        "should_not_call_tools": [
          "k8s_management",
          "ssh_execute"
        ],
        "notes": "无法定位时首轮直接返回最小补充材料请求，不应进入 k8s/ssh"
      }
    },
    {
      "id": "ET-A2",
      "category": "A",
      "subcategory": "A2",
      "title": "有显式服务名 — 应继续排查",
      "prompt": "看下 bkmonitorbeat 现在什么情况",
      "context": {
        "user_id": "sre-infra"
      },
      "expect": {
        "action": "continue_investigation",
        "must_not_action": "request_evidence",
        "preferred_tool_classes": [
          "unify_query"
        ],
        "should_resolve_service": true,
        "notes": "已给出服务名，应直接进入实时排查（telemetry-first），不应停在补材料。unify_query 类包含 query_promql/query_metrics/list_tag_keys 等。"
      }
    },
    {
      "id": "ET-B1",
      "category": "B",
      "subcategory": "B1",
      "title": "用户说没数据 — 应先验证 PromQL/时间窗",
      "prompt": "火影忍者的监控数据查出来是空的，仪表盘上没有数据",
      "context": {
        "user_id": "sre-gaming",
        "business": "火影忍者"
      },
      "expect": {
        "action": "continue_investigation",
        "should_verify_before_conclude": true,
        "must_contain": [
          "时间范围",
          "查询",
          "数据源",
          "指标"
        ],
        "notes": "v1.1：去掉 preferred_tool_classes 硬检查（playbook 快速路径无 toolCalls 是合理行为），保留关键词检查确保回复内容正确引导验证方向。"
      }
    },
    {
      "id": "ET-C1",
      "category": "C",
      "subcategory": "C1",
      "title": "指标异常排障 — telemetry-first",
      "prompt": "金铲铲之战海外版在线人数突然掉零了，帮我排查一下",
      "context": {
        "user_id": "sre-gaming",
        "business": "金铲铲之战"
      },
      "expect": {
        "action": "continue_investigation",
        "must_contain": [
          "在线人数",
          "序列"
        ],
        "must_not_first_tool": [
          "k8s_management",
          "ssh_execute"
        ],
        "notes": "v1.1：playbook 快速路径无 toolCalls 是合理行为。改为检查回复内容是否包含排障关键词，不再强制要求 toolCalls。"
      }
    },
    {
      "id": "ET-D1",
      "category": "D",
      "subcategory": "D1",
      "title": "Pod -> Service -> Deployment 关联",
      "prompt": "pod bk-monitor-web-5f8d7c-abc 一直在重启，帮我看看关联的 Service 和 Deployment 什么情况",
      "context": {
        "user_id": "sre-infra"
      },
      "expect": {
        "action": "continue_investigation",
        "preferred_tool_classes": [
          "relation"
        ],
        "should_stitch_entities": true,
        "entity_types": [
          "pod",
          "service",
          "deployment"
        ],
        "notes": "v1.1：只要求 relation 类（包含 query_relation_multi_resource 和 _range），去掉精确工具名要求。"
      }
    },
    {
      "id": "ET-E1",
      "category": "E",
      "subcategory": "E1",
      "title": "工具不足 — 输出卡点和最小补充材料",
      "prompt": "我们有个自研的日志采集器出问题了，数据没上报",
      "context": {
        "user_id": "sre-infra"
      },
      "expect": {
        "action": "collaborative_request",
        "must_contain_any": [
          [
            "卡点",
            "阻塞",
            "无法",
            "未找到",
            "未配置",
            "不可用"
          ],
          [
            "下一步",
            "建议",
            "排查方向",
            "排查",
            "假设",
            "原因"
          ],
          [
            "补充",
            "提供",
            "需要",
            "确认",
            "未确认"
          ]
        ],
        "must_not_contain_long_manual": true,
        "max_reply_length": 2000,
        "notes": "v1.1：放宽关键词覆盖 Opus 输出格式（'未确认假设'='卡点'，'排查'='排查方向'等）。核心判定：不应是泛化排障手册。"
      }
    }
  ]
}

# BASE_URL includes the provider's API prefix, such as /v1.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Duration syntax: 30s, 1m.
REQUEST_TIMEOUT=30s
MAX_LLM_CALLS=8

# Optional. Parent directory of skill folders such as bk-monitor/SKILL.md.
# Leave empty when the private skill checkout is not on this machine.
SKILLS_ROOT=

# Optional absolute path to bk-cli. Empty uses the binary on PATH.
BK_CLI_PATH=

# Optional directory for alert plans and approvals. Empty uses .sre-copilot.
STATE_DIR=

# Required only when serve listens outside loopback.
LOCAL_API_TOKEN=

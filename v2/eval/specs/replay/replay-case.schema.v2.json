{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sre-copilot.local/v2/replay-case.schema.v2.json",
  "title": "SRE Copilot V2 Replay Case Schema",
  "type": "object",
  "required": ["version", "cases"],
  "properties": {
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "input"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "required": ["message"],
            "properties": {
              "message": {
                "type": "string"
              },
              "context": {
                "type": "object"
              }
            },
            "additionalProperties": true
          },
          "intent_contract": {
            "type": "object",
            "properties": {
              "expected_mode": {
                "enum": ["request_evidence", "continue_investigation", "collaborative_request"]
              },
              "must_not_mode": {
                "type": "array",
                "items": {
                  "enum": ["request_evidence", "continue_investigation", "collaborative_request"]
                }
              }
            },
            "additionalProperties": true
          },
          "trajectory_contract": {
            "type": "object",
            "properties": {
              "preferred_first_tool_classes": {
                "type": "array",
                "items": {
                  "enum": ["unify_query", "relation", "knowledge", "k8s", "ssh"]
                }
              },
              "forbidden_first_tool_classes": {
                "type": "array",
                "items": {
                  "enum": ["unify_query", "relation", "knowledge", "k8s", "ssh"]
                }
              }
            },
            "additionalProperties": true
          },
          "evidence_contract": {
            "type": "object",
            "properties": {
              "must_have_any": {
                "type": "array",
                "items": {
                  "enum": ["service_resolution", "runtime_signal", "query_artifact", "gap", "user_supplied", "tool_result", "tool_failure"]
                }
              },
              "must_have_all": {
                "type": "array",
                "items": {
                  "enum": ["service_resolution", "runtime_signal", "query_artifact", "gap", "user_supplied", "tool_result", "tool_failure"]
                }
              },
              "must_not_be_knowledge_only": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "blocker_contract": {
            "type": "object",
            "properties": {
              "expect_present": {
                "type": "boolean"
              },
              "expected_code": {
                "enum": ["missing_target", "insufficient_context", "empty_result", "tool_timeout", "authentication_failed", "permission_denied", "tool_error", "adapter_unavailable"]
              },
              "allowed_codes": {
                "type": "array",
                "items": {
                  "enum": ["missing_target", "insufficient_context", "empty_result", "tool_timeout", "authentication_failed", "permission_denied", "tool_error", "adapter_unavailable"]
                }
              },
              "forbidden_codes": {
                "type": "array",
                "items": {
                  "enum": ["missing_target", "insufficient_context", "empty_result", "tool_timeout", "authentication_failed", "permission_denied", "tool_error", "adapter_unavailable"]
                }
              },
              "expected_retryable": {
                "type": "boolean"
              },
              "expected_tool_name": {
                "type": "string"
              },
              "missing_any": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing_all": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "conclusion_contract": {
            "type": "object",
            "properties": {
              "summary_must_contain_keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "next_actions_must_contain_keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "hypotheses_must_contain_keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confirmed_facts_must_contain_keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing_evidence_any": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing_evidence_all": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "tool_execution_contract": {
            "type": "object",
            "properties": {
              "min_calls": {
                "type": "number"
              },
              "max_calls": {
                "type": "number"
              },
              "expected_adapter": {
                "type": "string"
              },
              "required_tool_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_blocker_codes": {
                "type": "array",
                "items": {
                  "enum": ["missing_target", "insufficient_context", "empty_result", "tool_timeout", "authentication_failed", "permission_denied", "tool_error", "adapter_unavailable"]
                }
              },
              "must_have_success": {
                "type": "boolean"
              },
              "must_have_failure": {
                "type": "boolean"
              },
              "require_duration_ms": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "response_contract": {
            "type": "object",
            "properties": {
              "semantic_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_include_sections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_contain_keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_contain_any_groups": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "must_not_contain_keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_be_generic_manual": {
                "type": "boolean"
              },
              "max_reply_length": {
                "type": "number"
              }
            },
            "additionalProperties": true
          },
          "source": {
            "type": "object",
            "properties": {
              "origin": {
                "enum": ["v1", "v2"]
              },
              "legacy_case_id": {
                "type": "string"
              },
              "legacy_suite_version": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "subcategory": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

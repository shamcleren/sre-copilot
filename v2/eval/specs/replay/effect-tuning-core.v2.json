{
  "version": "2.0",
  "description": "V2 harness-first seed replay suite，首批只覆盖 A1 / A2 / B3 三个黄金路径 case。",
  "cases": [
    {
      "id": "V2-A1",
      "title": "无显式定位对象时请求最小材料",
      "input": {
        "message": "查下我的服务情况",
        "context": {
          "user_id": "sre-gaming"
        }
      },
      "intent_contract": {
        "expected_mode": "request_evidence"
      },
      "trajectory_contract": {
        "forbidden_first_tool_classes": ["k8s", "ssh"]
      },
      "evidence_contract": {
        "must_have_all": ["gap"]
      },
      "blocker_contract": {
        "expect_present": true,
        "expected_code": "missing_target",
        "missing_any": ["服务名", "Pod 名", "域名", "PromQL"]
      },
      "conclusion_contract": {
        "summary_must_contain_keywords": ["稳定定位排查对象"],
        "next_actions_must_contain_keywords": ["telemetry-first"],
        "missing_evidence_any": ["服务名", "Pod 名", "域名", "PromQL"]
      },
      "response_contract": {
        "must_include_sections": ["当前判断", "缺失材料", "下一步"],
        "max_reply_length": 500
      }
    },
    {
      "id": "V2-A2",
      "title": "显式服务名时进入 telemetry-first",
      "input": {
        "message": "看下 bkmonitorbeat 现在什么情况",
        "context": {
          "user_id": "sre-infra"
        }
      },
      "intent_contract": {
        "expected_mode": "continue_investigation",
        "must_not_mode": ["request_evidence"]
      },
      "trajectory_contract": {
        "preferred_first_tool_classes": ["unify_query"],
        "forbidden_first_tool_classes": ["k8s", "ssh"]
      },
      "evidence_contract": {
        "must_have_all": ["service_resolution", "runtime_signal"],
        "must_not_be_knowledge_only": true
      },
      "response_contract": {
        "must_include_sections": ["当前判断", "已确认事实", "下一步"],
        "max_reply_length": 500
      }
    },
    {
      "id": "V2-B3",
      "title": "显式 PromQL 时优先进入查询验证",
      "input": {
        "message": "帮我看下这个 PromQL 为什么返回空值：sum(rate(http_requests_total{service=\"chatinner\"}[5m])) by (status)",
        "context": {
          "user_id": "sre-platform",
          "business": "ChatInnerService"
        }
      },
      "intent_contract": {
        "expected_mode": "continue_investigation"
      },
      "trajectory_contract": {
        "preferred_first_tool_classes": ["unify_query"],
        "forbidden_first_tool_classes": ["k8s", "ssh"]
      },
      "evidence_contract": {
        "must_have_all": ["query_artifact", "runtime_signal"],
        "must_not_be_knowledge_only": true
      },
      "response_contract": {
        "must_include_sections": ["当前判断", "已确认事实", "下一步"],
        "max_reply_length": 700
      }
    }
  ]
}

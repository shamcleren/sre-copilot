{
  "name": "sre-copilot-runtime-assets",
  "private": true,
  "version": "0.1.0",
  "description": "SRE Copilot current runtime, replay and compare assets",
  "scripts": {
    "replay": "tsx eval/runners/replay-runner.ts",
    "replay:core": "tsx eval/runners/replay-runner.ts --cases eval/specs/replay/effect-tuning-core.v2.json",
    "replay:all": "tsx eval/runners/replay-runner.ts --cases eval/specs/replay/effect-tuning-all.v2.json",
    "cases:migrate": "tsx scripts/migrate-v1-replay-cases.ts",
    "compare:baseline": "tsx eval/runners/compare-v1-v2.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
